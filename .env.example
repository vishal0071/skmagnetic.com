# Copy to .env (on the server, and locally for `npm run admin`). Never commit .env.

# ---- Admin panel login (required) ----
ADMIN_USER=admin
# At least 10 characters — use a long, unique password
ADMIN_PASSWORD=
# 64 random characters:  openssl rand -hex 32
ADMIN_SECRET=

# ---- Email notification for new enquiries (optional) ----
# NOTIFY_EMAIL=sales@skmagnetic.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM="SK Enterprises website <you@gmail.com>"

# ---- Server / Traefik (defaults are correct for the galleryflow server) ----
SITE_DOMAIN=skmagnetic.com
# Docker network of galleryflow's Traefik:  docker network ls | grep galleryflow
TRAEFIK_NETWORK=galleryflow_galleryflow
CERT_RESOLVER=le

# ---- Local development only ----
# SERVE_SITE=1      # admin also serves the built site at http://localhost:8787
