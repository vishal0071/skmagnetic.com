---
/** Card for industries and applications — whole card is the link. */
import Icon from './Icon.astro';
interface Props {
  href: string;
  title: string;
  text: string;
  icon: string;
  links?: { label: string; href: string }[];
  headingLevel?: 'h2' | 'h3';
  compact?: boolean;
}
const { href, title, text, icon, links = [], headingLevel: H = 'h3', compact = false } = Astro.props;
---

<article class:list={['card card--hover card--link link-card', { 'link-card--compact': compact }]} data-reveal>
  <div class="card__body">
    <div class="link-card__top">
      <span class="link-card__icon"><Icon name={icon} size={26} /></span>
      <span class="link-card__arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
    </div>
    <H class="card__title"><a href={href}>{title}</a></H>
    <p class="card__text">{text}</p>
    {
      links.length > 0 && (
        <ul class="link-card__links">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .link-card .card__body {
    gap: 10px;
    padding: 26px;
  }
  .link-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .link-card__icon {
    color: var(--red);
  }
  .link-card__arrow {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink-900);
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .link-card:hover .link-card__arrow {
    background: var(--ink-900);
    border-color: var(--ink-900);
    color: #fff;
    transform: translateX(2px);
  }
  .link-card__links {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 6px;
    margin-top: 6px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: var(--fs-xs);
  }
  .link-card__links a {
    color: var(--ink-800);
    font-weight: 600;
    text-decoration: none;
  }
  .link-card__links a::before {
    content: '→ ';
    color: var(--red);
  }
  .link-card__links a:hover {
    color: var(--red);
  }
  .link-card--compact .card__body {
    padding: 22px;
  }
  .link-card--compact .card__title {
    font-size: 1.0625rem;
  }
</style>
