---
interface Props {
  items: { label: string; href: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, i) =>
        i === items.length - 1 ? (
          <li>
            <span aria-current="page">{item.label}</span>
          </li>
        ) : (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
