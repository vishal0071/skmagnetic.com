---
/** Sticky Call | WhatsApp | Enquire bar — mobile only. */
import { whatsappMessages } from '@/config/site';
import { quoteUrl, telHref, whatsappHref } from '@/lib/links';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  whatsappMessage?: string;
  product?: { name: string; slug: string };
}
const { whatsappMessage, product } = Astro.props;
const message = whatsappMessage ?? (product ? whatsappMessages.product(product.name) : whatsappMessages.general);
---

<nav class="mobile-bar" aria-label="Quick contact">
  <a href={telHref()} class="mobile-bar__btn mobile-bar__btn--call" data-track="phone_click" data-location="mobile_bar">
    <Icon name="phone" size={20} />
    <span>Call</span>
  </a>
  <a
    href={whatsappHref(message)}
    class="mobile-bar__btn mobile-bar__btn--wa"
    target="_blank"
    rel="noopener"
    data-track="whatsapp_click"
    data-location="mobile_bar"
    data-product={product?.name}
  >
    <Icon name="whatsapp" size={20} />
    <span>WhatsApp</span>
  </a>
  <a
    href={quoteUrl(product?.slug)}
    class="mobile-bar__btn mobile-bar__btn--quote"
    data-track="cta_click"
    data-location="mobile_bar"
    data-product={product?.name}
  >
    <Icon name="send" size={20} />
    <span>Enquire</span>
  </a>
</nav>

<style>
  .mobile-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    gap: 8px;
    padding: 8px 10px calc(8px + env(safe-area-inset-bottom));
    background: rgb(255 255 255 / 0.97);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
    box-shadow: 0 -8px 24px -12px rgb(11 20 29 / 0.25);
  }
  @media (min-width: 960px) {
    .mobile-bar {
      display: none;
    }
  }
  .mobile-bar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 48px;
    border-radius: var(--radius-sm);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
  }
  .mobile-bar__btn:hover {
    color: #fff;
  }
  .mobile-bar__btn--call {
    background: var(--ink-900);
  }
  .mobile-bar__btn--wa {
    background: var(--wa);
  }
  .mobile-bar__btn--quote {
    background: var(--red);
  }
</style>
