---
/**
 * Site logo: the S⚡K emblem (generated by `npm run assets` → src/assets/brand/emblem.png)
 * plus a live-text wordmark. Brand files for print/social live in /public/brand/.
 */
import { Image } from 'astro:assets';
import { site } from '@/config/site';
import emblem from '@/assets/brand/emblem.png';

interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: className } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${variant}`, className]} aria-label={`${site.brand} — ${site.tagline}, home`}>
  <Image src={emblem} alt="" height={44} densities={[1, 2]} class="logo__mark" loading={variant === 'dark' ? 'eager' : 'lazy'} decoding="async" />
  <span class="logo__text">
    <span class="logo__name"><span class="logo__sk">SK</span> ENTERPRISES</span>
    <span class="logo__line">{site.tagline}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink-900);
    flex: none;
  }
  .logo :global(.logo__mark) {
    flex: none;
    width: auto;
    height: 44px;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__name {
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: 0.035em;
  }
  .logo__sk {
    color: var(--red);
    font-weight: 820;
    letter-spacing: 0;
  }
  .logo__line {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.65625rem;
    font-weight: 620;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .logo--light {
    color: #fff;
  }
  .logo--light .logo__sk {
    color: #ff5a4e;
  }
  .logo--light .logo__line {
    color: #8fa0b0;
  }
  .logo:hover {
    color: inherit;
  }
  @media (max-width: 479.98px) {
    .logo {
      gap: 10px;
    }
    .logo :global(.logo__mark) {
      height: 38px;
    }
    .logo__name {
      font-size: 1.125rem;
    }
  }
  @media (max-width: 380px) {
    .logo__line {
      display: none;
    }
  }
</style>
