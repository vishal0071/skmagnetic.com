---
/**
 * Site logo: the S⚡K mark (generated by `npm run assets` → src/assets/brand/mark.svg)
 * plus a live-text wordmark. Brand files for print/social live in /public/brand/.
 */
import { site } from '@/config/site';
import mark from '@/assets/brand/mark.svg?raw';

interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: className } = Astro.props;
const markSvg = mark.replace('<svg ', '<svg class="logo__mark" width="44" height="44" aria-hidden="true" focusable="false" ');
---

<a href="/" class:list={['logo', `logo--${variant}`, className]} aria-label={`${site.brand} — ${site.tagline}, home`}>
  <Fragment set:html={markSvg} />
  <span class="logo__text">
    <span class="logo__name"><span class="logo__sk">SK</span> ENTERPRISES</span>
    <span class="logo__line">{site.tagline}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink-900);
    flex: none;
  }
  .logo :global(.logo__mark) {
    flex: none;
    border-radius: 10px;
  }
  .logo--light :global(.logo__mark) {
    box-shadow: 0 0 0 1px #1d2c3a;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo__name {
    font-size: 1.25rem;
    font-weight: 750;
    letter-spacing: 0.035em;
  }
  .logo__sk {
    color: var(--red);
    font-weight: 820;
    letter-spacing: 0;
  }
  .logo__line {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.65625rem;
    font-weight: 620;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .logo--light {
    color: #fff;
  }
  .logo--light .logo__sk {
    color: #ff5a4e;
  }
  .logo--light .logo__line {
    color: #8fa0b0;
  }
  .logo:hover {
    color: inherit;
  }
  @media (max-width: 380px) {
    .logo__line {
      display: none;
    }
  }
</style>
