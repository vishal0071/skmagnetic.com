---
/**
 * Product gallery. Multiple photos → swipeable, scroll-snapping gallery with
 * thumbnail links (no JavaScript). No photos → product illustration.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '@/config/site';
import type { IllustrationKind } from '@/lib/illustrations';
import ProductVisual from './ProductVisual.astro';

interface Props {
  title: string;
  illustration: IllustrationKind;
  images: { src: ImageMetadata; alt: string }[];
}
const { title, illustration, images } = Astro.props;
---

<div class="gallery">
  {
    images.length > 1 ? (
      <>
        <div class="gallery__track" tabindex="0" aria-label={`${title} photos`}>
          {images.map((img, i) => (
            <figure class="gallery__slide media" id={`photo-${i + 1}`}>
              <Picture
                src={img.src}
                alt={img.alt}
                formats={['avif', 'webp']}
                widths={[480, 720, 960, 1280]}
                sizes="(min-width: 1100px) 600px, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
            </figure>
          ))}
        </div>
        <ul class="gallery__thumbs">
          {images.map((img, i) => (
            <li>
              <a href={`#photo-${i + 1}`} aria-label={`Show photo ${i + 1}: ${img.alt}`}>
                <Picture src={img.src} alt="" formats={['avif', 'webp']} widths={[160]} sizes="80px" loading="lazy" />
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <ProductVisual
        illustration={illustration}
        images={images}
        alt={images[0]?.alt ?? `${title} — product illustration`}
        eager
        sizes="(min-width: 1100px) 600px, 100vw"
        class="gallery__single"
      />
    )
  }
  {images.length === 0 && site.showContentNotices && <p class="gallery__note review-only">Illustration shown — add real product photos in the product’s content file.</p>}
</div>

<style>
  .gallery :global(.media) {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .gallery__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-lg);
  }
  .gallery__track::-webkit-scrollbar {
    display: none;
  }
  .gallery__slide {
    margin: 0;
    scroll-snap-align: start;
  }
  .gallery__thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    list-style: none;
  }
  .gallery__thumbs a {
    display: block;
    width: 80px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .gallery__thumbs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery__note {
    margin-top: 8px;
    color: #5c4400;
    font-size: var(--fs-xs);
  }
</style>
