---
/**
 * Product gallery. Photos sit in a swipeable, scroll-snapping strip (arrows, counter and
 * thumbnails when there are several) and open full screen in a lightbox that slides too.
 * Without JavaScript the strip still swipes and each photo links to its full-size file.
 * No photos → product illustration.
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '@/config/site';
import type { IllustrationKind } from '@/lib/illustrations';
import Icon from '@/components/ui/Icon.astro';
import ProductVisual from './ProductVisual.astro';

interface Props {
  title: string;
  illustration: IllustrationKind;
  images: { src: ImageMetadata; alt: string }[];
}
const { title, illustration, images } = Astro.props;
const many = images.length > 1;

// Full-screen sizes, never larger than the uploaded photo
const fullWidths = (w: number) => [...new Set([720, 1280, 1920].filter((x) => x < w).concat(Math.min(w, 2400)))];
// The photo fills the screen height when it is tall, so size it from its shape
const fullSizes = (img: ImageMetadata) => `min(100vw, ${Math.round((img.width / img.height) * 86)}vh)`;
const fullFiles = await Promise.all(images.map((img) => getImage({ src: img.src, width: Math.min(img.src.width, 2000), format: 'webp' })));
---

<div class="gallery" data-gallery>
  {
    images.length ? (
      <>
        <div class="gallery__main">
          <div class="gallery__track" tabindex={many ? '0' : undefined} aria-label={many ? `${title} photos` : undefined} data-track>
            {images.map((img, i) => (
              <figure class="gallery__slide media media--photo" id={`photo-${i + 1}`}>
                <a class="gallery__open" href={fullFiles[i].src} data-open={i} aria-label={`View full screen: ${img.alt}`}>
                  <Picture
                    src={img.src}
                    alt={img.alt}
                    formats={['avif', 'webp']}
                    widths={[480, 720, 960, 1280]}
                    sizes="(min-width: 1100px) 600px, 100vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                  />
                </a>
              </figure>
            ))}
          </div>
          {many && (
            <>
              <button type="button" class="gallery__nav gallery__nav--prev" data-prev aria-label="Previous photo">
                <Icon name="chevron-left" size={22} />
              </button>
              <button type="button" class="gallery__nav gallery__nav--next" data-next aria-label="Next photo">
                <Icon name="chevron-right" size={22} />
              </button>
              <span class="gallery__badge gallery__count" data-count aria-hidden="true">
                1 / {images.length}
              </span>
            </>
          )}
          <span class="gallery__badge gallery__zoom" aria-hidden="true">
            <Icon name="expand" size={16} />
          </span>
        </div>
        {many && (
          <ul class="gallery__thumbs">
            {images.map((img, i) => (
              <li>
                <a href={`#photo-${i + 1}`} data-thumb={i} aria-current={i === 0 ? 'true' : 'false'} aria-label={`Show photo ${i + 1}: ${img.alt}`}>
                  <Picture src={img.src} alt="" formats={['avif', 'webp']} widths={[160]} sizes="80px" loading="lazy" />
                </a>
              </li>
            ))}
          </ul>
        )}

        <dialog class="lightbox" data-lightbox aria-label={`${title} — photos`}>
          <div class="lightbox__bar">
            <span class="lightbox__count" data-lb-count>
              {many && `1 / ${images.length}`}
            </span>
            <button type="button" class="lightbox__btn" data-close aria-label="Close">
              <Icon name="close" size={24} />
            </button>
          </div>
          <div class="lightbox__track" data-lb-track>
            {images.map((img) => (
              <figure class="lightbox__slide">
                <Picture src={img.src} alt={img.alt} formats={['avif', 'webp']} widths={fullWidths(img.src.width)} sizes={fullSizes(img.src)} loading="lazy" decoding="async" />
                <figcaption aria-hidden="true">{img.alt}</figcaption>
              </figure>
            ))}
          </div>
          {many && (
            <>
              <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Previous photo">
                <Icon name="chevron-left" size={26} />
              </button>
              <button type="button" class="lightbox__btn lightbox__nav lightbox__nav--next" data-lb-next aria-label="Next photo">
                <Icon name="chevron-right" size={26} />
              </button>
            </>
          )}
        </dialog>
      </>
    ) : (
      <ProductVisual illustration={illustration} alt={`${title} — product illustration`} eager sizes="(min-width: 1100px) 600px, 100vw" class="gallery__single" />
    )
  }
  {images.length === 0 && site.showContentNotices && <p class="gallery__note review-only">Illustration shown — add real product photos in the product’s content file.</p>}
</div>

<script>
  const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-track]');
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]');
    const lbTrack = dialog?.querySelector<HTMLElement>('[data-lb-track]');
    if (!track || !dialog || !lbTrack) return;
    const count = track.children.length;
    const $ = <T extends Element>(s: string, root: ParentNode = gallery) => root.querySelector<T>(s);

    const indexOf = (strip: HTMLElement) => Math.round(strip.scrollLeft / strip.clientWidth);
    const go = (strip: HTMLElement, i: number, animate = smooth) =>
      strip.scrollTo({ left: Math.max(0, Math.min(count - 1, i)) * strip.clientWidth, behavior: animate ? 'smooth' : 'instant' });
    const onSlide = (strip: HTMLElement, render: (i: number) => void) => {
      let frame = 0;
      strip.addEventListener('scroll', () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => render(indexOf(strip)));
      }, { passive: true });
      render(0);
    };

    // ---------- Photo strip on the page ----------
    const prev = $<HTMLButtonElement>('[data-prev]');
    const next = $<HTMLButtonElement>('[data-next]');
    const counter = $('[data-count]');
    const thumbs = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-thumb]')];
    onSlide(track, (i) => {
      if (counter) counter.textContent = `${i + 1} / ${count}`;
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === count - 1;
      thumbs.forEach((t, n) => t.setAttribute('aria-current', String(n === i)));
    });
    prev?.addEventListener('click', () => go(track, indexOf(track) - 1));
    next?.addEventListener('click', () => go(track, indexOf(track) + 1));
    thumbs.forEach((t, n) =>
      t.addEventListener('click', (e) => {
        e.preventDefault();
        go(track, n);
      }),
    );

    // ---------- Full-screen viewer ----------
    const lbPrev = $<HTMLButtonElement>('[data-lb-prev]', dialog);
    const lbNext = $<HTMLButtonElement>('[data-lb-next]', dialog);
    const lbCount = $('[data-lb-count]', dialog);
    let lbIndex = 0; // remembered: the hidden viewer cannot be measured once it closes
    onSlide(lbTrack, (i) => {
      lbIndex = i;
      if (lbCount && count > 1) lbCount.textContent = `${i + 1} / ${count}`;
      if (lbPrev) lbPrev.disabled = i === 0;
      if (lbNext) lbNext.disabled = i === count - 1;
    });
    gallery.querySelectorAll<HTMLElement>('[data-open]').forEach((link) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        go(lbTrack, Number(link.dataset.open), false);
      }),
    );
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      go(track, lbIndex, false);
    });
    $('[data-close]', dialog)?.addEventListener('click', () => dialog.close());
    lbPrev?.addEventListener('click', () => go(lbTrack, indexOf(lbTrack) - 1));
    lbNext?.addEventListener('click', () => go(lbTrack, indexOf(lbTrack) + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      go(lbTrack, indexOf(lbTrack) + (e.key === 'ArrowLeft' ? -1 : 1));
    });
    // A tap on the dark area around the photo closes the viewer
    lbTrack.addEventListener('click', (e) => {
      if (!(e.target as Element).closest('img, figcaption')) dialog.close();
    });
  });
</script>

<style>
  .gallery :global(.media) {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .gallery__main {
    position: relative;
  }
  .gallery__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-lg);
  }
  .gallery__track::-webkit-scrollbar {
    display: none;
  }
  .gallery__slide {
    margin: 0;
    scroll-snap-align: start;
  }
  .gallery__open {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }
  .gallery__open :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gallery__nav {
    position: absolute;
    top: 50%;
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.94);
    color: var(--ink-900);
    box-shadow: var(--shadow);
    cursor: pointer;
    translate: 0 -50%;
    transition: opacity 0.2s var(--ease);
  }
  :global(.js) .gallery__nav {
    display: grid;
  }
  .gallery__nav--prev {
    left: 12px;
  }
  .gallery__nav--next {
    right: 12px;
  }
  .gallery__nav:disabled {
    opacity: 0;
    pointer-events: none;
  }
  .gallery__badge {
    position: absolute;
    bottom: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(11 20 29 / 0.72);
    color: #fff;
    font-size: var(--fs-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .gallery__count {
    left: 12px;
  }
  .gallery__zoom {
    right: 12px;
    display: none;
    padding: 6px;
  }
  :global(.js) .gallery__zoom {
    display: grid;
  }
  .gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
    list-style: none;
  }
  .gallery__thumbs a {
    display: block;
    width: 80px;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--white);
  }
  .gallery__thumbs a[aria-current='true'] {
    border-color: var(--red);
    box-shadow: 0 0 0 1px var(--red);
  }
  .gallery__thumbs :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .gallery__note {
    margin-top: 8px;
    color: #5c4400;
    font-size: var(--fs-xs);
  }

  /* ---------- Full-screen viewer ---------- */
  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #080c12;
    color: #fff;
    overflow: hidden;
  }
  .lightbox[open] {
    display: flex;
    flex-direction: column;
  }
  .lightbox::backdrop {
    background: rgb(8 12 18 / 0.6);
  }
  .lightbox__bar {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    padding: max(8px, env(safe-area-inset-top)) 8px 8px 20px;
  }
  .lightbox__count {
    color: #c9d3dc;
    font-size: var(--fs-sm);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .lightbox__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    cursor: pointer;
    transition:
      background 0.2s var(--ease),
      opacity 0.2s var(--ease);
  }
  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.22);
  }
  .lightbox__track {
    display: grid;
    flex: 1;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    min-height: 0;
    overflow-x: auto;
    overscroll-behavior: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .lightbox__track::-webkit-scrollbar {
    display: none;
  }
  .lightbox__slide {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0;
    padding: 0 16px max(20px, env(safe-area-inset-bottom));
    scroll-snap-align: center;
  }
  .lightbox__slide :global(img) {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: calc(100vh - 140px);
    max-height: calc(100dvh - 140px);
    border-radius: var(--radius-sm);
    object-fit: contain;
  }
  .lightbox__slide figcaption {
    max-width: 60ch;
    color: #c9d3dc;
    font-size: var(--fs-sm);
    text-align: center;
  }
  .lightbox__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__nav--prev {
    left: 12px;
  }
  .lightbox__nav--next {
    right: 12px;
  }
  .lightbox__nav:disabled {
    opacity: 0;
    pointer-events: none;
  }
  @media (max-width: 639.98px) {
    .lightbox__nav {
      width: 40px;
      height: 40px;
    }
    .lightbox__nav--prev {
      left: 6px;
    }
    .lightbox__nav--next {
      right: 6px;
    }
  }
</style>
