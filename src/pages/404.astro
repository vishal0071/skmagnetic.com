---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCategories } from '@/lib/content';
import { categoryUrl } from '@/lib/links';
import Icon from '@/components/ui/Icon.astro';

const categories = await getCategories();
---

<BaseLayout title="Page Not Found | SK Enterprises" description="The page you are looking for could not be found. Browse SK Enterprises products or contact our team." noindex>
  <section class="section nf">
    <div class="container container--narrow">
      <p class="eyebrow">Error 404</p>
      <h1>We couldn’t find that page</h1>
      <p class="lead mt-2">The link may be old or mistyped. Try one of these instead, or tell us what you were looking for.</p>
      <div class="btn-row mt-4">
        <a class="btn btn--primary btn--lg" href="/products/">Browse products</a>
        <a class="btn btn--outline btn--lg" href="/contact/">Contact us</a>
      </div>
      <ul class="nf-links mt-6">
        {
          categories.map((c) => (
            <li>
              <a href={categoryUrl(c.id)}>
                {c.data.title} <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))
        }
        <li><a href="/blog/">Buying guides <Icon name="arrow-right" size={16} /></a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-links {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .nf-links a {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-900);
    font-weight: 600;
    text-decoration: none;
  }
  .nf-links a:hover {
    color: var(--red);
  }
</style>
