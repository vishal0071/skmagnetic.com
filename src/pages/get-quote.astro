---
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { breadcrumbs as breadcrumbSchema, webPage } from '@/lib/schema';
import { telHref, whatsappHref } from '@/lib/links';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Icon from '@/components/ui/Icon.astro';
import Ph from '@/components/ui/Ph.astro';
import EnquiryForm from '@/components/forms/EnquiryForm.astro';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Get a Quote', href: '/get-quote/' },
];
const title = 'Get a Quote for Magnetizers & Fixtures | SK Enterprises';
const description =
  'Request a quotation for a magnetizer, magnet charging machine, magnetizing coil or fixture. Share your part and magnet details — SK Enterprises will respond quickly.';
---

<BaseLayout footerCta={false} title={title} description={description} schema={[webPage({ name: 'Get a Quote', description, url: '/get-quote/' }), breadcrumbSchema(crumbs)]}>
  <section class="quote-page">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="quote-grid">
        <div class="quote-intro">
          <p class="eyebrow">Request a quotation</p>
          <h1>Get a quote</h1>
          <p class="lead">
            Tell us what you need to magnetize and we’ll come back with a recommended configuration, price and delivery time<Ph text={site.contact.responseTime} before=" — usually " />.
          </p>

          <ol class="quote-steps">
            <li><strong>Choose the product</strong><span>Pick a machine or fixture, or choose “Other / not sure”.</span></li>
            <li><strong>Describe the part</strong><span>What you magnetize, its size, and the magnet material and grade.</span></li>
            <li><strong>Add pole pattern &amp; output</strong><span>Axial, radial or multi-pole, and parts per hour or shift.</span></li>
            <li><strong>Attach a drawing (optional)</strong><span>Part drawings, photos or datasheets help us quote accurately.</span></li>
          </ol>

          <div class="quote-alt">
            <p>Prefer to talk?</p>
            <div class="btn-row">
              <a class="btn btn--wa" href={whatsappHref()} target="_blank" rel="noopener" data-track="whatsapp_click" data-location="quote_page"
                ><Icon name="whatsapp" size={18} />WhatsApp Us</a
              >
              <a class="btn btn--outline" href={telHref()} data-track="phone_click" data-location="quote_page"><Icon name="phone" size={18} />Call Now</a>
            </div>
          </div>
        </div>

        <div class="form-card">
          <h2 class="form-card__title">Your requirement</h2>
          <p class="text-muted mt-1 mb-form">Fields marked * are required.</p>
          <EnquiryForm id="quote-form" type="quote" location="quote_page" submitLabel="Submit Enquiry" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quote-page {
    padding-block: 28px var(--section);
    background: linear-gradient(180deg, var(--steel-50), #fff 420px);
  }
  .quote-grid {
    display: grid;
    gap: 40px;
    margin-top: 28px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .quote-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 64px;
    }
    .quote-intro {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }
  }
  .quote-intro .lead {
    margin-top: 16px;
  }
  .quote-steps {
    display: grid;
    gap: 14px;
    margin-top: 32px;
    list-style: none;
    counter-reset: q;
  }
  .quote-steps li {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-left: 48px;
    counter-increment: q;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .quote-steps li::before {
    content: counter(q);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--ink-900);
    color: #fff;
    font-weight: 700;
    font-size: 0.875rem;
  }
  .quote-steps strong {
    color: var(--ink-900);
    font-size: 1rem;
  }
  .quote-alt {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .quote-alt p {
    margin-bottom: 12px;
    color: var(--ink-900);
    font-weight: 650;
  }
  .form-card {
    padding: clamp(22px, 4vw, 40px);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .form-card__title {
    font-size: 1.5rem;
  }
  .mb-form {
    margin-bottom: 24px;
  }
</style>
