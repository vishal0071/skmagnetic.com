# syntax=docker/dockerfile:1
# SK Enterprises website admin — settings, content, enquiries, SEO report, publishing.
FROM node:22-alpine
WORKDIR /app
ENV ASTRO_TELEMETRY_DISABLED=1 NODE_ENV=production PROJECT_DIR=/app SITE_ROOT=/srv/site DATA_DIR=/app/data PORT=8787
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY . .
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8787/api/health || exit 1
CMD ["node", "admin/server.mjs"]
